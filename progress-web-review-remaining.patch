+    gap: 8px;
+    margin-top: 8px;
+}
+
+.history-link {
+    display: inline-block;
+    text-decoration: none;
+    border: 1px solid #ddd;
+    border-radius: 8px;
+    padding: 8px 12px;
+    color: #222;
